{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "adapters/**/*",
    "fixtures/**/*",
    "tests/**/*",
    "experiments/**/*"
  ]
}
